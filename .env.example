# Bhorsha (ভরসা) - Environment Configuration
# Copy this file to .env for local development

# Server Port (Render sets this automatically to 10000)
PORT=3000

# Environment Mode (production / development)
NODE_ENV=production

# JWT Authentication Secret Key (Generate a random 32+ character string in production)
JWT_SECRET=bhorsha_secure_jwt_token_secret_key_2026_change_in_production

# Optional: Persistent SQLite Database Directory (e.g. for Render Persistent Disk /var/data)
# DATA_DIR=/var/data
# DB_PATH=/var/data/bhorsha.db

# Optional: Security controls for production
# ALLOW_PROD_RESET=false # If true, allows authenticated admins to reset DB in production
# DISABLE_DEMO_LOGIN=false # If true, disables 1-click demo login buttons in production
